@description('The resource ID of the community to which the enclave will connect.')
param communityResourceId string

@allowed([
  'Both'
  'CommunityOnly'
  'EnclaveOnly'
])
@description('The destination for diagnostic logs generated by the enclave.')
param diagnosticDestination string

@description('Determine whether to enable the Azure Bastion for the enclave.')
param enableBastion bool

@description('The address space for the enclave virtual network when a "custom" network size is specified.')
param enclaveAddressSpace string = ''

@description('The location for the enclave.')
param location string

@allowed([
  'Governance'
  'Networking'
  'Off'
])
@description('The justification for enabling maintenance mode on the enclave.')
param maintenanceModeJustification string

@description('The principals allowed to enable maintenance mode on the enclave.')
param maintenanceModePrincipals array

@allowed([
  'Advanced'
  'Generial'
  'Off'
])
@description('The setting for maintenance mode on the enclave.')
param maintenanceModeSetting string

@description('The name of the enclave.')
param name string

@allowed([
  'small'
  'medium'
  'large'
  'custom'
])
@description('The network size for the enclave.')
param networkSize string

@description('The subnet configurations for the enclave virtual network.')
param subnetConfigurations array

@description('The metadata to be applied to the enclave resource.')
param tags object

resource virtualEnclave 'Microsoft.Mission/virtualEnclaves@2026-03-01-preview' = {
  name: name
  location: location
  tags: tags[?'Microsoft.Mission/virtualEnclaves'] ?? {}
  properties: {
    bastionEnabled: enableBastion
    communityResourceId: communityResourceId
    enclaveDefaultSettings: {
      diagnosticDestination: diagnosticDestination
    }
    enclaveRoleAssignments: []
    enclaveVirtualNetwork: {
      allowSubnetCommunication: true
      customCidrRange: empty(enclaveAddressSpace) ? null : enclaveAddressSpace
      networkSize: networkSize
      subnetConfigurations: subnetConfigurations
    }
    maintenanceModeConfiguration: {
      justification: maintenanceModeJustification
      mode: maintenanceModeSetting
      principals: maintenanceModePrincipals
    }
    workloadRoleAssignments: []
  }
}

output properties object = virtualEnclave.properties
output resourceId string = virtualEnclave.id
